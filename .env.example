# PostgreSQL local (Docker Compose)
POSTGRES_USER=tripmate
POSTGRES_PASSWORD=tripmate_local_password
POSTGRES_DB=tripmate
POSTGRES_PORT=5432

# Mantenha esta URL alinhada com as variaveis POSTGRES_* acima.
DATABASE_URL=postgresql://tripmate:tripmate_local_password@127.0.0.1:5432/tripmate

# Groq: preencha a chave e escolha um modelo disponivel para sua conta.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Pesquisa de hospedagens
TAVILY_API_KEY=

# Consulta de voos e aeroporto de origem padrao (GRU = Guarulhos)
AVIATIONSTACK_API_KEY=
DEFAULT_ORIGIN_IATA=GRU

# LangSmith (opcional): para ativar, use true e preencha a chave.
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=tripmate-ai
